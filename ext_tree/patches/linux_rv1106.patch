+/* TX reset control for clock synchronizer reset */
+static ssize_t tx_reset_show(struct device *dev,
+                             struct device_attribute *attr,
+                             char *buf)
+{
+    return sprintf(buf, "write '1' to perform TX reset\n");
+}
+
+static ssize_t tx_reset_store(struct device *dev,
+                              struct device_attribute *attr,
+                              const char *buf, size_t count)
+{
+    struct rk_i2s_tdm_dev *i2s_tdm = dev_get_drvdata(dev);
+    int enable;
+
+    if (sscanf(buf, "%d", &enable) != 1 || enable != 1)
+        return -EINVAL;
+
+    if (!i2s_tdm->tx_reset || !i2s_tdm->rx_reset) {
+        dev_err(dev, "TX/RX reset not available\n");
+        return -ENODEV;
+    }
+
+    /* Perform full I2S block reset to clear clock synchronizer state */
+    /* Order: HCLK (bus) -> TX/RX (datapath) */
+    if (i2s_tdm->hclk_reset) {
+        reset_control_assert(i2s_tdm->hclk_reset);
+    }
+    reset_control_assert(i2s_tdm->tx_reset);
+    reset_control_assert(i2s_tdm->rx_reset);
+    udelay(100);  /* Increased from 10us to 100us for complete clock synchronizer reset */
+    if (i2s_tdm->hclk_reset) {
+        reset_control_deassert(i2s_tdm->hclk_reset);
+    }
+    reset_control_deassert(i2s_tdm->tx_reset);
+    reset_control_deassert(i2s_tdm->rx_reset);
+
+    if (i2s_tdm->hclk_reset) {
+        dev_info(dev, "Full I2S block reset performed (HCLK+TX+RX)\n");
+    } else {
+        dev_info(dev, "TX/RX reset performed\n");
+    }
+
+    return count;
+}
+
+static DEVICE_ATTR(tx_reset, 0644, tx_reset_show, tx_reset_store);
