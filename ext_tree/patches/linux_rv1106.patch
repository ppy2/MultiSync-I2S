+    }
+    
+    mutex_lock(&i2s_tdm->mute_lock);
+    
+    /* Do NOT unmute if format change mute is active */
+    if (i2s_tdm->format_change_mute) {
+        dev_info(i2s_tdm->dev, "POST-MUTE: Skipping unmute - format change in progress\n");
+        mutex_unlock(&i2s_tdm->mute_lock);
+        return;
+    }
+    
+    /* Unmute if auto_mute is active and no user mute priority */
+    /* This work is only scheduled from TRIGGER_START, so stream is running */
+    dev_info(i2s_tdm->dev, "POST-MUTE: auto_mute=%d user_priority=%d\n", 
+             i2s_tdm->auto_mute_active, i2s_tdm->user_mute_priority);
+    
+    if (i2s_tdm->auto_mute_active && !i2s_tdm->user_mute_priority) {
+        i2s_tdm->auto_mute_active = false;
+        i2s_tdm->mute = false;
+        if (i2s_tdm->mute_gpio) {
+            gpiod_set_value(i2s_tdm->mute_gpio, 0);
+            if (i2s_tdm->mute_inv_gpio)
+                gpiod_set_value(i2s_tdm->mute_inv_gpio, 1);
+        }
+        dev_info(i2s_tdm->dev, "POST-MUTE: Unmuted after %dms\n", i2s_tdm->postmute_delay_ms);
+        
+        /* Notify ALSA control about mute state change */
+        if (i2s_tdm->mute_kcontrol && i2s_tdm->dai && i2s_tdm->dai->component) {
+            snd_ctl_notify(i2s_tdm->dai->component->card->snd_card, 
+                          SNDRV_CTL_EVENT_MASK_VALUE, 
+                          &i2s_tdm->mute_kcontrol->id);
+        }
+    } else {
+        dev_info(i2s_tdm->dev, "POST-MUTE: Unmute BLOCKED\n");
+    }
+    
+    mutex_unlock(&i2s_tdm->mute_lock);
+}
+
+/* Unmute delayed_work callback (runs in separate kworker thread - zero jitter on data path) */
+static void rockchip_i2s_tdm_unmute_work(struct work_struct *work)
+{
+    struct rk_i2s_tdm_dev *i2s_tdm = container_of(work, struct rk_i2s_tdm_dev, unmute_work.work);
+
+    if (!i2s_tdm->mute_control_enable)
+        return;
+    if (i2s_tdm->user_mute_priority || i2s_tdm->format_change_mute)
+        return;
+
+    mutex_lock(&i2s_tdm->mute_lock);
+    if (i2s_tdm->auto_mute_active) {
+        if (i2s_tdm->mute_gpio) {
+            gpiod_set_value(i2s_tdm->mute_gpio, 0);
+            if (i2s_tdm->mute_inv_gpio)
+                gpiod_set_value(i2s_tdm->mute_inv_gpio, 1);
+        }
+        i2s_tdm->auto_mute_active = false;
+        i2s_tdm->mute = false;
+        dev_dbg(i2s_tdm->dev, "Delayed unmute: GPIO unmuted after %u ms\n",
+                i2s_tdm->unmute_after_ms);
+    }
+    mutex_unlock(&i2s_tdm->mute_lock);
+}
+
+/* Slave HW sync IRQ handler — fires when master pulses GPIO1_C7 after BCK starts */
+static irqreturn_t rockchip_i2s_tdm_sync_irq(int irq, void *dev_id)
+{
+    struct rk_i2s_tdm_dev *i2s_tdm = dev_id;
+
+    i2s_tdm->sync_irq_armed = false;
+    disable_irq_nosync(irq);
+
+    /*
+     * Enable XFER now — master BCLK has NOT started yet (master waits 1 ms
+     * after pulsing GPIO before enabling BCLK).  Slave FIFO pre-fills with
+     * audio[0..N] while waiting.  When master BCLK arrives ~1 ms later,
+     * both master and slave output audio[0] on the first BCLK edge → BIT-EXACT.
+     */
+    if (i2s_tdm->clk_trcm)
+        rockchip_i2s_tdm_xfer_trcm_start(i2s_tdm);
+    else
+        rockchip_i2s_tdm_xfer_start(i2s_tdm, SNDRV_PCM_STREAM_PLAYBACK);
+
+    dev_info(i2s_tdm->dev,
+             "HW_SYNC_IRQ: SLAVE XFER enabled at %lld ns (waiting for master BCLK)\n",
+             ktime_to_ns(ktime_get_real()));
+
+    return IRQ_HANDLED;
+}
+
+/* Master delayed BCLK start - runs in kworker after master_start_delay_ms */
+static void rockchip_i2s_tdm_master_xfer_work(struct work_struct *work)
+{
+    struct rk_i2s_tdm_dev *i2s_tdm = container_of(work, struct rk_i2s_tdm_dev, master_xfer_work.work);
+
+    /* Check if stop was called while we were waiting */
+    if (!i2s_tdm->xfer_pending)
+        return;
+
+    i2s_tdm->xfer_pending = false;
+
+    /*
+     * Bit-exact sync sequence:
+     *   1. Pulse GPIO HIGH → slave IRQ fires → slave enables XFER → slave FIFO pre-fills
+     *   2. Wait 1 ms — guarantees slave XFER is enabled before BCLK starts
+     *      (IRQ latency is ~50 µs; 1 ms is 20× margin)
+     *   3. Enable BCLK — slave FIFO is already loaded with audio[0..N]
+     *      Both master and slave output audio[0] on the very first BCLK edge → BIT-EXACT
+     */
+    if (i2s_tdm->sync_gpio) {
+        gpiod_set_value(i2s_tdm->sync_gpio, 1);
+        dev_info(i2s_tdm->dev,
+                 "MASTER_XFER: sync GPIO pulsed HIGH at %lld ns — waiting 1 ms for slave XFER\n",
+                 ktime_to_ns(ktime_get_real()));
+        usleep_range(1000, 1100);   /* slave IRQ latency ~50 µs; 1 ms = 20× margin */
+    }
+
+    /* Start BCLK — slave is already waiting with XFER enabled and FIFO pre-filled */
+    if (i2s_tdm->clk_trcm)
+        rockchip_i2s_tdm_xfer_trcm_start(i2s_tdm);
+    else
+        rockchip_i2s_tdm_xfer_start(i2s_tdm, SNDRV_PCM_STREAM_PLAYBACK);
+
+    dev_info(i2s_tdm->dev,
+             "MASTER_XFER: BCLK started at %lld ns (delayed %u ms + 1 ms GPIO), unmute in %u ms\n",
+             ktime_to_ns(ktime_get_real()), i2s_tdm->master_start_delay_ms,
+             i2s_tdm->unmute_after_ms);
+
+    /*
+     * Schedule unmute AFTER BCLK starts (not at TRIGGER_START).
+     * Window: if any slave failed to sync, its ALSA buffer drains in ~8 ms (8 periods × 1 ms),
+     * HQPlayer detects the xrun and sends TRIGGER_STOP, which cancels this work.
+     * Result: MUTE stays active → no audio on failed sync → clean retry.
+     * unmute_after_ms (default 100 ms) must exceed HQPlayer's failure detection latency.
+     */
+    if (i2s_tdm->mute_control_enable && !i2s_tdm->user_mute_priority) {
+        schedule_delayed_work(&i2s_tdm->unmute_work,
+                              msecs_to_jiffies(i2s_tdm->unmute_after_ms));
+    }
+}
+
+/*
+ * FIFO underflow monitor - checks I2S_INTSR.TXUI every 100ms.
+ * TX underflow means DMA didn't feed FIFO in time → samples lost → desync.
+ */
+static void rockchip_i2s_tdm_fifo_mon_work(struct work_struct *work)
+{
+    struct rk_i2s_tdm_dev *i2s_tdm = container_of(work, struct rk_i2s_tdm_dev, fifo_mon_work.work);
+    struct snd_pcm_substream *substream;
+    struct snd_pcm_runtime *runtime;
+    unsigned int intsr, fifolr;
+
+    if (!i2s_tdm->fifo_mon_active)
+        return;
+
+    /* Read interrupt status - check TX underflow */
+    regmap_read(i2s_tdm->regmap, I2S_INTSR, &intsr);
+
+    if (intsr & I2S_INTSR_TXUI_ACT) {
+        /* TX FIFO underflow detected! */
+        regmap_read(i2s_tdm->regmap, I2S_TXFIFOLR, &fifolr);
+        i2s_tdm->fifo_underflow_count++;
+
+        dev_err(i2s_tdm->dev,
+                "*** TX FIFO UNDERFLOW #%lu at %lld ns! INTSR=0x%08x FIFOLR=0x%08x ***\n",
+                i2s_tdm->fifo_underflow_count,
+                ktime_to_ns(ktime_get_real()), intsr, fifolr);
+
+        /* Clear underflow flag by writing TXUIC */
+        regmap_update_bits(i2s_tdm->regmap, I2S_INTCR,
+                           I2S_INTCR_TXUIC, I2S_INTCR_TXUIC);
+    }
+
+    /* Log hw_ptr every 10 seconds (100 ticks * 100ms) */
+    i2s_tdm->fifo_mon_tick++;
+    if (i2s_tdm->fifo_mon_tick >= 100) {
+        i2s_tdm->fifo_mon_tick = 0;
+
+        substream = i2s_tdm->substreams[SNDRV_PCM_STREAM_PLAYBACK];
+        if (substream && substream->runtime) {
+            snd_pcm_uframes_t pos;
+            unsigned int *buf;
+
+            runtime = substream->runtime;
+            regmap_read(i2s_tdm->regmap, I2S_TXFIFOLR, &fifolr);
+
+            /* Read 4 samples from current hw_ptr position in ring buffer */
+            pos = runtime->status->hw_ptr % runtime->buffer_size;
+            buf = (unsigned int *)(runtime->dma_area +
+                  frames_to_bytes(runtime, pos));
+
+            dev_dbg(i2s_tdm->dev,
+                    "MON: %s hw=%ld app=%ld dly=%ld FL=0x%08x t=%lld d[%ld]=%08x,%08x,%08x,%08x\n",
+                     i2s_tdm->is_master_mode ? "M" : "S",
+                     (long)runtime->status->hw_ptr,
+                     (long)runtime->control->appl_ptr,
+                     (long)snd_pcm_playback_hw_avail(runtime),
+                     fifolr,
+                     ktime_to_ns(ktime_get_real()),
+                     (long)pos,
+                     buf[0], buf[1], buf[2], buf[3]);
+        }
+    }
+
+    /* Reschedule every 100ms */
+    if (i2s_tdm->fifo_mon_active)
+        schedule_delayed_work(&i2s_tdm->fifo_mon_work, msecs_to_jiffies(100));
+}
