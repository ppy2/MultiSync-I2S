+/* Custom PCM pointer with drift compensation for multi-node sync.
+ *
+ * Problem: two nodes share BCLK (identical I2S output rate), but NAA daemon
+ * uses ALSA hw_ptr for rate control. DMA pointer granularity and system clock
+ * drift cause NAA to write data at slightly different rates on each node,
+ * leading to gradual audio content desynchronization at PCM384.
+ *
+ * Solution: apply configurable drift_ppb correction to the reported pointer,
+ * allowing fine-tuning of the apparent consumption rate seen by NAA.
+ */
+static snd_pcm_uframes_t rockchip_i2s_tdm_pointer(
+    struct snd_soc_component *component,
+    struct snd_pcm_substream *substream)
+{
+    struct rk_i2s_tdm_dev *i2s_tdm;
+    snd_pcm_uframes_t pos, raw_pos;
+    snd_pcm_uframes_t buffer_size;
+
+    /* Get base position from DMA engine */
+    raw_pos = snd_dmaengine_pcm_pointer(substream);
+
+    i2s_tdm = snd_soc_component_get_drvdata(component);
+    if (!substream->runtime || !i2s_tdm)
+        return raw_pos;
+
+    buffer_size = substream->runtime->buffer_size;
+    if (buffer_size == 0)
+        return raw_pos;
+
+    /* Update monotonic frame counter using raw DMA position */
+    if (substream->stream == SNDRV_PCM_STREAM_PLAYBACK) {
+        snd_pcm_uframes_t delta;
+        if (raw_pos >= i2s_tdm->last_ptr_pos)
+            delta = raw_pos - i2s_tdm->last_ptr_pos;
+        else
+            delta = buffer_size - i2s_tdm->last_ptr_pos + raw_pos;
+        /* Sanity: delta should not exceed half the buffer (wrap guard) */
+        if (delta <= buffer_size / 2)
+            i2s_tdm->frame_counter += delta;
+        i2s_tdm->last_ptr_pos = raw_pos;
+    }
+
+    pos = raw_pos;
+
+    /* Apply drift compensation (playback only) */
+    if (i2s_tdm->drift_ppb != 0 && i2s_tdm->current_rate > 0 &&
+        substream->stream == SNDRV_PCM_STREAM_PLAYBACK) {
+        s64 elapsed_us = ktime_us_delta(ktime_get(),
+                                        i2s_tdm->playback_start_time);
+        /* elapsed_frames = elapsed_seconds * sample_rate
+         * Use div_s64 for ARM32 (no native 64-bit division) */
+        s64 elapsed_frames = div_s64(elapsed_us * (s64)i2s_tdm->current_rate,
+                                     1000000LL);
+        /* correction = elapsed_frames * drift_ppb / 1e9 */
+        s64 correction = div_s64(elapsed_frames * i2s_tdm->drift_ppb,
+                                 1000000000LL);
+
+        if (correction != 0) {
+            s64 adjusted = (s64)pos + correction;
+            adjusted = div_s64(adjusted, (s64)buffer_size);
+            adjusted = (s64)pos + correction - adjusted * (s64)buffer_size;
+            if (adjusted < 0)
+                adjusted += buffer_size;
+            pos = (snd_pcm_uframes_t)adjusted;
+        }
+    }
+
+    /* Apply manual offset */
+    if (i2s_tdm->pointer_offset_frames != 0 &&
+        substream->stream == SNDRV_PCM_STREAM_PLAYBACK) {
+        s64 adjusted = (s64)pos + i2s_tdm->pointer_offset_frames;
+        s64 q = div_s64(adjusted, (s64)buffer_size);
+        adjusted = adjusted - q * (s64)buffer_size;
+        if (adjusted < 0)
+            adjusted += buffer_size;
+        pos = (snd_pcm_uframes_t)adjusted;
+    }
+
+    return pos;
+}
