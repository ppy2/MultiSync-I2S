+        /* Only unmute if stream is running */
+        if (stream_running) {
+            i2s_tdm->auto_mute_active = false;
+            cancel_delayed_work(&i2s_tdm->mute_post_work);
+            rockchip_i2s_tdm_apply_mute(i2s_tdm, false);
