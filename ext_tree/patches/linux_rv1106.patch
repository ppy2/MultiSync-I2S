+/* Pinctrl state control sysfs interface for BCK/LRCLK isolation */
+static ssize_t pinctrl_state_show(struct device *dev,
+                                  struct device_attribute *attr,
+                                  char *buf)
+{
+    struct rk_i2s_tdm_dev *i2s_tdm = dev_get_drvdata(dev);
+
+    if (!i2s_tdm->pinctrl || !i2s_tdm->pins_default || !i2s_tdm->pins_idle)
+        return sprintf(buf, "unavailable\n");
+
+    /* We don't track current state, just report capability */
+    return sprintf(buf, "available (write 'idle' or 'default')\n");
+}
+
+static ssize_t pinctrl_state_store(struct device *dev,
+                                   struct device_attribute *attr,
+                                   const char *buf, size_t count)
+{
+    struct rk_i2s_tdm_dev *i2s_tdm = dev_get_drvdata(dev);
+    int ret;
+
+    if (!i2s_tdm->pinctrl || !i2s_tdm->pins_default || !i2s_tdm->pins_idle) {
+        dev_err(dev, "Pinctrl states not available\n");
+        return -ENODEV;
+    }
+
+    if (strncmp(buf, "idle", 4) == 0) {
+        ret = pinctrl_select_state(i2s_tdm->pinctrl, i2s_tdm->pins_idle);
+        if (ret) {
+            dev_err(dev, "Failed to select idle pinctrl state: %d\n", ret);
+            return ret;
+        }
+        dev_info(dev, "BCK/LRCLK switched to GPIO (idle)\n");
+    } else if (strncmp(buf, "default", 7) == 0) {
+        ret = pinctrl_select_state(i2s_tdm->pinctrl, i2s_tdm->pins_default);
+        if (ret) {
+            dev_err(dev, "Failed to select default pinctrl state: %d\n", ret);
+            return ret;
+        }
+        dev_info(dev, "BCK/LRCLK switched to I2S (default)\n");
+    } else {
+        dev_err(dev, "Invalid pinctrl state (use 'idle' or 'default')\n");
+        return -EINVAL;
+    }
+
+    return count;
+}
+
+static DEVICE_ATTR(pinctrl_state, 0644, pinctrl_state_show, pinctrl_state_store);
