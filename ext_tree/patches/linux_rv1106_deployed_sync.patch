+/*
+ * Playback START reset. Runs in ALSA trigger context, never from the C7 IRQ.
+ * The independent sysfs controls apply to the next START.
+ */
+static void rockchip_i2s_tdm_pre_start_reset(struct rk_i2s_tdm_dev *i2s_tdm)
+{
+    bool reset_hclk = i2s_tdm->pre_start_reset_hclk && i2s_tdm->hclk_reset;
+    bool reset_tx = i2s_tdm->pre_start_reset_tx && i2s_tdm->tx_reset;
+    bool reset_rx = i2s_tdm->pre_start_reset_rx && i2s_tdm->rx_reset;
+
+    if (!reset_hclk && !reset_tx && !reset_rx)
+        return;
+
+    if (reset_hclk)
+        reset_control_assert(i2s_tdm->hclk_reset);
+    if (reset_tx)
+        reset_control_assert(i2s_tdm->tx_reset);
+    if (reset_rx)
+        reset_control_assert(i2s_tdm->rx_reset);
+
+    udelay(100);
+
+    if (reset_hclk)
+        reset_control_deassert(i2s_tdm->hclk_reset);
+    if (reset_tx)
+        reset_control_deassert(i2s_tdm->tx_reset);
+    if (reset_rx)
+        reset_control_deassert(i2s_tdm->rx_reset);
+}
