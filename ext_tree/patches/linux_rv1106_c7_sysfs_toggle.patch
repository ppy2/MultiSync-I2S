 static DEVICE_ATTR(master_start_delay_ms, 0644, master_start_delay_ms_show, master_start_delay_ms_store);
 
+/* Runtime C7 A/B switch. Changes take effect on the next playback START only. */
+static ssize_t sync_gpio_enable_show(struct device *dev,
+                                     struct device_attribute *attr, char *buf)
+{
+    struct rk_i2s_tdm_dev *i2s_tdm = dev_get_drvdata(dev);
+    return sprintf(buf, "%u\n", i2s_tdm->sync_gpio_enable ? 1 : 0);
+}
+
+static ssize_t sync_gpio_enable_store(struct device *dev,
+                                      struct device_attribute *attr,
+                                      const char *buf, size_t count)
+{
+    struct rk_i2s_tdm_dev *i2s_tdm = dev_get_drvdata(dev);
+    unsigned int enable;
+
+    if (kstrtouint(buf, 10, &enable) || enable > 1)
+        return -EINVAL;
+
+    i2s_tdm->sync_gpio_enable = !!enable;
+    if (!enable && i2s_tdm->sync_gpio)
+        gpiod_set_value(i2s_tdm->sync_gpio, 0);
+    dev_info(i2s_tdm->dev, "C7 sync GPIO %s; applies at next playback START\n",
+             enable ? "enabled" : "disabled");
+    return count;
+}
+
+static DEVICE_ATTR(sync_gpio_enable, 0644,
+                   sync_gpio_enable_show, sync_gpio_enable_store);
+
