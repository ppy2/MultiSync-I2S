+/* One TX/RX reset at the C7 common-start boundary.  No HCLK and no
+ * inter-assert delay: this is an A/B experiment, not a generic reset path. */
+static void rockchip_i2s_tdm_c7_reset(struct rk_i2s_tdm_dev *i2s_tdm)
+{
+    if (IS_ERR_OR_NULL(i2s_tdm->tx_reset) ||
+        IS_ERR_OR_NULL(i2s_tdm->rx_reset))
+        return;
+
+    reset_control_assert(i2s_tdm->tx_reset);
+    reset_control_assert(i2s_tdm->rx_reset);
+    reset_control_deassert(i2s_tdm->rx_reset);
+    reset_control_deassert(i2s_tdm->tx_reset);
+    dev_info(i2s_tdm->dev, "C7_TXRX_RESET: complete at %lld ns\n",
+             ktime_to_ns(ktime_get_real()));
+}
+
