--- a/sound/soc/rockchip/rockchip_i2s_tdm.c
+++ b/sound/soc/rockchip/rockchip_i2s_tdm.c
@@ -222,6 +222,19 @@
 static void rockchip_i2s_tdm_tx_path_config(struct rk_i2s_tdm_dev *i2s_tdm, int num);
 static void rockchip_i2s_tdm_log_xfer_regs(struct rk_i2s_tdm_dev *i2s_tdm, const char *where);
 
+/* C6 is a shared open-drain diagnostic marker only: LOW asserts, HIGH releases. */
+static inline void rockchip_i2s_tdm_c6_pulse(struct rk_i2s_tdm_dev *i2s_tdm,
+                                              const char *where)
+{
+    if (!i2s_tdm->ready_gpio || gpiod_cansleep(i2s_tdm->ready_gpio))
+        return;
+    gpiod_set_value(i2s_tdm->ready_gpio, 0);
+    udelay(10);
+    gpiod_set_value(i2s_tdm->ready_gpio, 1);
+    dev_info(i2s_tdm->dev, "C6_DIAG_PULSE: %s at %lld ns\n",
+             where, ktime_to_ns(ktime_get_real()));
+}
+
 
 
 /* DSD physical channel swap function (I2S routing) */
