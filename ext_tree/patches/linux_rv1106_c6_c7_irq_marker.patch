     i2s_tdm->sync_irq_armed = false;
     disable_irq_nosync(irq);
 
+    /* Hardware-timed marker at the first instruction of the GPIO IRQ path. */
+    rockchip_i2s_tdm_c6_pulse(i2s_tdm, "slave-irq");
+
     /*
