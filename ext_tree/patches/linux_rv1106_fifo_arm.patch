+/* C6 READY: release only after every TX FIFO has a safe prefill level. */
+static void rockchip_i2s_tdm_fifo_ready_work(struct work_struct *work)
+{
+    struct rk_i2s_tdm_dev *i2s_tdm = container_of(work, struct rk_i2s_tdm_dev, fifo_ready_work.work);
+    unsigned int fifolr, f0, f1, f2, f3;
+
+    if (!i2s_tdm->fifo_ready_armed || i2s_tdm->fifo_ready_released)
+        return;
+    regmap_read(i2s_tdm->regmap, I2S_TXFIFOLR, &fifolr);
+    f0 = (fifolr >> I2S_FIFOLR_TFL0_SHIFT) & 0x3f;
+    f1 = (fifolr >> I2S_FIFOLR_TFL1_SHIFT) & 0x3f;
+    f2 = (fifolr >> I2S_FIFOLR_TFL2_SHIFT) & 0x3f;
+    f3 = (fifolr >> I2S_FIFOLR_TFL3_SHIFT) & 0x3f;
+    i2s_tdm->fifo_ready_ticks++;
+    if (f0 >= 8 && f1 >= 8 && f2 >= 8 && f3 >= 8) {
+        i2s_tdm->fifo_ready_released = true;
+        if (!i2s_tdm->is_master_mode) {
+            if (i2s_tdm->ready_gpio)
+                gpiod_set_value(i2s_tdm->ready_gpio, 1);
+            dev_info(i2s_tdm->dev, "C6 FIFO_READY slave released FIFOLR=0x%08x ticks=%u\n",
+                     fifolr, i2s_tdm->fifo_ready_ticks);
+            return;
+        }
+        if (i2s_tdm->is_master_mode) {
+            if (i2s_tdm->fifo_ready_ticks < 5) {
+                i2s_tdm->fifo_ready_released = false;
+                schedule_delayed_work(&i2s_tdm->fifo_ready_work, msecs_to_jiffies(1));
+                return;
+            }
+            if (i2s_tdm->ready_gpio)
+                gpiod_direction_input(i2s_tdm->ready_gpio);
+            if (i2s_tdm->ready_gpio && gpiod_get_value(i2s_tdm->ready_gpio)) {
+                i2s_tdm->fifo_ready_released = true;
+                i2s_tdm->xfer_pending = true;
+                schedule_delayed_work(&i2s_tdm->master_xfer_work, 0);
+                dev_info(i2s_tdm->dev, "C6 FIFO_READY all armed FIFOLR=0x%08x; committing C7\n", fifolr);
+                return;
+            }
+            i2s_tdm->fifo_ready_released = false;
+        }
+    }
+    if (i2s_tdm->fifo_ready_ticks < 500)
+        schedule_delayed_work(&i2s_tdm->fifo_ready_work, msecs_to_jiffies(1));
+    else
+        dev_warn(i2s_tdm->dev, "C6 FIFO_READY timeout FIFOLR=0x%08x\n", fifolr);
+}
