+/* Read-only post-TXS hardware snapshot for first-DATA diagnosis. */
+static void rockchip_i2s_tdm_log_xfer_regs(struct rk_i2s_tdm_dev *i2s_tdm,
+                                           const char *where)
+{
+    unsigned int xfer, txcr, dmacr, fifolr, intsr;
+
+    regmap_read(i2s_tdm->regmap, I2S_XFER, &xfer);
+    regmap_read(i2s_tdm->regmap, I2S_TXCR, &txcr);
+    regmap_read(i2s_tdm->regmap, I2S_DMACR, &dmacr);
+    regmap_read(i2s_tdm->regmap, I2S_TXFIFOLR, &fifolr);
+    regmap_read(i2s_tdm->regmap, I2S_INTSR, &intsr);
+    dev_info(i2s_tdm->dev,
+             "XFER_REG_SNAPSHOT: %s at %lld ns XFER=0x%08x TXCR=0x%08x DMACR=0x%08x FIFOLR=0x%08x INTSR=0x%08x\n",
+             where, ktime_to_ns(ktime_get_real()), xfer, txcr, dmacr,
+             fifolr, intsr);
+}
+
