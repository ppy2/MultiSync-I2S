+     * Enable the slave serializer on the shared C7 boundary.  BCLK/LRCK may
+     * already be physically continuous across a seek, so this path must not
+     * assume that a later master XFER creates the first clock edge.
      */
     if (i2s_tdm->clk_trcm)
         rockchip_i2s_tdm_xfer_trcm_start(i2s_tdm);
@@ -2583,12 +2582,15 @@
     if (i2s_tdm->sync_gpio) {
         gpiod_set_value(i2s_tdm->sync_gpio, 1);
         dev_info(i2s_tdm->dev,
-                 "MASTER_XFER: sync GPIO pulsed HIGH at %lld ns — waiting 1 ms for slave XFER\n",
+                 "MASTER_XFER: sync GPIO HIGH at %lld ns — immediate master XFER (continuous-clock diagnostic)\n",
                  ktime_to_ns(ktime_get_real()));
-        usleep_range(1000, 1100);   /* slave IRQ latency ~50 µs; 1 ms = 20× margin */
     }
 
-    /* Start BCLK — slave is already waiting with XFER enabled and FIFO pre-filled */
+    /*
