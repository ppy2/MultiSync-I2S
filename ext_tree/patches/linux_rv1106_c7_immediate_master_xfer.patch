@@ -2533,7 +2533,7 @@
              fifolr, intsr);
 }
 
-/* Slave HW sync IRQ handler — fires when master pulses GPIO1_C7 after BCK starts */
+/* Slave HW sync IRQ handler — fires on the shared GPIO1_C7 edge. */
 static irqreturn_t rockchip_i2s_tdm_sync_irq(int irq, void *dev_id)
 {
     struct rk_i2s_tdm_dev *i2s_tdm = dev_id;
@@ -2542,10 +2542,9 @@
     disable_irq_nosync(irq);
 
     /*
-     * Enable XFER now — master BCLK has NOT started yet (master waits 1 ms
-     * after pulsing GPIO before enabling BCLK).  Slave FIFO pre-fills with
