     struct gpio_desc *sync_gpio;   /* HW sync wire GPIO1_C7: master=OUT, slave=IN */
     int sync_irq;                  /* slave: GPIO interrupt number (-1 if unused) */
     bool sync_irq_armed;           /* slave: IRQ is armed, waiting for master pulse */
+    bool clear_failed_pending;      /* local SCLK-domain CLR timed out; recover at next START */
     bool freq_domain_invert;        // Invert frequency domain GPIO polarity
     
