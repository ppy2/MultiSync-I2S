# Chrony configuration for MASTER node
# Ultra-smooth sync: slave relies on our clock stability

# NTP servers - poll VERY slowly to avoid chasing internet jitter
# minpoll 8 = 256s, maxpoll 12 = 4096s (~1 hour)
pool pool.ntp.org maxsources 4 minpoll 8 maxpoll 12
pool time.cloudflare.com maxsources 2 minpoll 8 maxpoll 12

# Record clock drift for smooth startup
driftfile /var/lib/chrony/drift

# Sync kernel RTC
rtcsync

# Initial acquisition always applies one immediate correction, even for a
# sub-second offset. After that first update, all corrections are slew-only.
makestep 0.0 1

# Very slow slew rate: max 10 ppm frequency adjustment
# At 10 ppm, correcting 1ms takes 100 seconds - very smooth
maxslewrate 10

# Spread corrections over longer periods
# Default 3.0, higher = more gradual corrections
corrtimeratio 20

# Limit frequency adjustment rate
# Don't chase short-term NTP jitter
maxupdateskew 20.0

# Serve smooth time to slave
# Smooth out our own corrections over 400 seconds
# so slave sees ultra-stable time source
smoothtime 400 0.001 leaponly

# Allow NTP client access from any network (for slave)
allow 0.0.0.0/0

# Minimum sources
minsources 1

# Serve time even when not fully synced
local stratum 10

# NTS keys
ntsdumpdir /var/lib/chrony
