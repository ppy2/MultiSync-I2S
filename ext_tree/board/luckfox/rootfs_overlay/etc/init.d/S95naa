#!/bin/sh

#LOG=/tmp/log

start() {
    printf "Starting NAA: "

    echo 150 > /sys/devices/platform/ffae0000.i2s/master_start_delay_ms
    echo 0 > /sys/devices/platform/ffae0000.i2s/post_stop_reset_hclk
    echo 0 > /sys/devices/platform/ffae0000.i2s/post_stop_reset_rx
    echo 0 > /sys/devices/platform/ffae0000.i2s/post_stop_reset_tx
    echo 0 > /sys/devices/platform/ffae0000.i2s/pre_start_reset_hclk
    echo 1 > /sys/devices/platform/ffae0000.i2s/pre_start_reset_tx
    echo 0 > /sys/devices/platform/ffae0000.i2s/pre_start_reset_rx

    if [ -f /usr/lib/libasound_nodrain.so ]; then
        LD_PRELOAD=/usr/lib/libasound_nodrain.so /usr/sbin/networkaudiod > /dev/null 2>&1 &
    else
        /usr/sbin/networkaudiod > /dev/null 2>&1 &
    fi

    sleep 0.5
    if [ -f /tmp/mixer_control_cache ]; then
        MIXER=$(cat /tmp/mixer_control_cache | cut -d, -f1 | tr -d "'")
        [ -n "$MIXER" ] && amixer set "$MIXER" unmute 2>/dev/null
    fi
}

stop() {

    killall -9 networkaudiod
}

restart() {
    stop
    start
}

case "$1" in
  start|stop|restart) "$1" ;;
  *) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac

exit $?
