#!/bin/sh
#
# Resolve master node IP via mDNS (avahi) and write to /etc/hosts.
# Runs only on slave nodes, after avahi-daemon (S50).
# This ensures "master" hostname resolves in any network without DNS.
#

# Only run on slave nodes
if ! readlink /etc/networkaudiod/onstart 2>/dev/null | grep -q slave; then
    exit 0
fi

echo "started (background)"

# Run resolution in background — does not block boot
(
    while true; do
        MASTER_IP=$(avahi-resolve-host-name -4 master.local 2>/dev/null | awk '{print $2}')
        if [ -n "$MASTER_IP" ]; then
            sed -i '/master/d' /etc/hosts
            echo "$MASTER_IP master master.local" >> /etc/hosts
            chronyc reload >/dev/null 2>&1
            logger -t resolve-master "master.local resolved: $MASTER_IP"
            break
        fi
        sleep 1
    done
) &

exit 0
