#!/bin/sh
# Read hostname assigned by avahi after conflict resolution.
# If another "slave" is already on the network, avahi picks "slave-2", etc.
# Wait for avahi state=RUNNING (probing complete) before reading the name.

case "$1" in
  start)
    [ "$(cat /etc/hostname 2>/dev/null)" = "master" ] && exit 0

    # Wait for avahi state RUNNING (2) — probing + conflict resolution done
    for i in $(seq 1 30); do
        STATE=$(dbus-send --system --print-reply --dest=org.freedesktop.Avahi \
            / org.freedesktop.Avahi.Server.GetState 2>/dev/null | \
            grep int32 | awk '{print $2}')
        [ "$STATE" = "2" ] && break
        sleep 0.2
    done

    AVAHI_HOST=$(dbus-send --system --print-reply --dest=org.freedesktop.Avahi \
        / org.freedesktop.Avahi.Server.GetHostName 2>/dev/null | \
        grep string | sed 's/.*"\(.*\)"/\1/')

    if [ -n "$AVAHI_HOST" ]; then
        hostname "$AVAHI_HOST"
        CURRENT=$(cat /etc/hostname 2>/dev/null)
        if [ "$AVAHI_HOST" != "$CURRENT" ]; then
            echo "$AVAHI_HOST" > /etc/hostname
        fi
        printf "Hostname: %s\n" "$AVAHI_HOST"
    fi
    ;;
esac
