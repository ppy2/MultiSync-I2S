# Chrony configuration for SLAVE node - OPTIMIZED
# Sync ONLY from master node for nanosecond precision

# Use ONLY master node as NTP source
# minpoll 2 = poll every 4 seconds, maxpoll 6 = max every 64 seconds
server master.lan iburst prefer minpoll 2 maxpoll 6

# DO NOT use internet NTP - causes offset swings
# Uncomment only as backup if master unreachable
#pool pool.ntp.org iburst maxsources 1 minpoll 8 maxpoll 10

# Record clock drift
driftfile /var/lib/chrony/drift

# Sync kernel RTC
rtcsync

# Allow large steps in first 3 updates
makestep 1.0 3

# Single source OK
minsources 1

# Logging
logdir /var/log/chrony
log measurements statistics tracking

# Local stratum when not synced
local stratum 10
