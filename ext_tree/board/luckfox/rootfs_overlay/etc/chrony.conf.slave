# Chrony configuration for SLAVE node
# Tight tracking of master, smooth during playback

# Master node as sole time source
# minpoll 2 = 4s, maxpoll 5 = 32s - tight tracking on local network
server master iburst prefer minpoll 2 maxpoll 5

# NO internet NTP - only master

# Record clock drift
driftfile /var/lib/chrony/drift

# Sync kernel RTC
rtcsync

# Allow steps ONLY during first 3 updates after boot
makestep 1.0 3

# After boot: NO automatic stepping, slew only
# Forced step is done explicitly in onstart_slave.sh before playback

# Smooth slew rate during playback
maxslewrate 20

# Gradual corrections
corrtimeratio 10

# Single source OK
minsources 1
