# Chrony configuration for SLAVE node
# Local master is the sole source. No playback-time hooks are permitted.

# xleave enables interleaved NTP when supported by chronyd on master. Keep the
# LAN estimate fresh every 4–8 seconds without per-playback chrony work.
server master xleave iburst prefer minpoll 2 maxpoll 3

# NO internet NTP - only master

driftfile /var/lib/chrony/drift
rtcsync

# Initial acquisition always applies one immediate correction, even for a
# sub-second offset. After that first update, all corrections are slew-only.
makestep 0.0 1
# Smooth bounded corrections while the NAA daemon is running.
maxslewrate 20
corrtimeratio 10
minsources 1
